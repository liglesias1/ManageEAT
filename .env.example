# Copy this file to .env and set your own values. .env is in .gitignore and must never be committed.
# SQL Server requires at least 8 characters with upper case, lower case, a digit and a symbol.
# The two service passwords go inside a connection string, so avoid @ : / # % in them.

MSSQL_SA_PASSWORD=
SALES_DB_PASSWORD=
PERSONNEL_DB_PASSWORD=

# Signs the login tokens; both services use it. Any long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=